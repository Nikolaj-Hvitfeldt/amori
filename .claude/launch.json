{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "frontend-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "frontend", "run", "web", "--", "--port", "8081"],
      "port": 8081
    },
    {
      "name": "frontend-web-mock",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "frontend", "run", "web:mock", "--", "--port", "8082"],
      "env": { "EXPO_PUBLIC_MOCK": "1" },
      "port": 8082
    }
  ]
}
