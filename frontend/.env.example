SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key

# Mock mode (development builds only; ignored by production exports)
# 1 = answer every API call from the in-memory fake backend with synthetic fixtures,
# and block all network requests except blob:, data:, file: and localhost.
# `npm run web:mock` sets this for you.
EXPO_PUBLIC_MOCK=0
# Data set in mock mode: default (fixtures) | empty (empty states) | error (HTTP 500 everywhere).
# On web, ?mockScenario=<name> in the page URL overrides this.
EXPO_PUBLIC_MOCK_SCENARIO=default
