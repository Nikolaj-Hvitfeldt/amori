{
  "expo": {
    "name": "Amori",
    "slug": "amori",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "splash": {
      "backgroundColor": "#241a16",
      "image": "./assets/splash.png",
      "resizeMode": "contain"
    },
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.amori.app"
    },
    "android": {
      "backgroundColor": "#241a16",
      "package": "com.amori.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      }
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png",
      "name": "Amori - Your Love Story",
      "shortName": "Amori",
      "lang": "en",
      "scope": "/",
      "themeColor": "#241a16",
      "backgroundColor": "#241a16",
      "display": "standalone",
      "orientation": "portrait",
      "startUrl": "/",
      "description": "A beautiful journal app for couples to capture and cherish their special moments together",
      "dir": "ltr",
      "preferRelatedApplications": false,
      "apple": {
        "appleTouchIcon": "./assets/icon.png",
        "statusBarStyle": "black-translucent"
      }
    },
    "plugins": [
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
